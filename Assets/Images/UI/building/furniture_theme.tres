[gd_resource type="Theme" format=3]

[ext_resource type="FontVariation" path="res://Assets/Fonts/font_bold.tres" id="font"]
[ext_resource type="Texture2D" path="res://Assets/Images/UI/building/plant/card.png" id="card"]
[ext_resource type="Texture2D" path="res://Assets/Images/UI/building/plant/crop_tile.png" id="tile"]
[ext_resource type="Texture2D" path="res://Assets/Images/UI/building/06-primary-button.png" id="action"]

[sub_resource type="FontVariation" id="furniture_font"]
base_font = ExtResource("font")
variation_embolden = 0.55

[sub_resource type="StyleBoxTexture" id="card"]
texture = ExtResource("card")
texture_margin_left = 22.0
texture_margin_top = 22.0
texture_margin_right = 22.0
texture_margin_bottom = 22.0
modulate_color = Color(0.82, 0.85, 1, 1)

[sub_resource type="StyleBoxTexture" id="tile"]
texture = ExtResource("tile")
texture_margin_left = 21.0
texture_margin_top = 21.0
texture_margin_right = 21.0
texture_margin_bottom = 21.0
modulate_color = Color(0.91, 0.92, 1, 1)

[sub_resource type="StyleBoxTexture" id="normal"]
content_margin_left = 10.0
content_margin_top = 0.0
content_margin_right = 10.0
content_margin_bottom = 8.0
texture = ExtResource("action")
texture_margin_left = 32.0
texture_margin_right = 32.0

[sub_resource type="StyleBoxTexture" id="hover"]
content_margin_left = 10.0
content_margin_top = 0.0
content_margin_right = 10.0
content_margin_bottom = 8.0
texture = ExtResource("action")
texture_margin_left = 32.0
texture_margin_right = 32.0
modulate_color = Color(1.08, 1.09, 1.11, 1)

[sub_resource type="StyleBoxTexture" id="pressed"]
content_margin_left = 10.0
content_margin_top = 0.0
content_margin_right = 10.0
content_margin_bottom = 8.0
texture = ExtResource("action")
texture_margin_left = 32.0
texture_margin_right = 32.0
modulate_color = Color(0.83, 0.85, 0.88, 1)

[sub_resource type="StyleBoxFlat" id="focus"]
bg_color = Color(0, 0, 0, 0)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.60, 0.81, 0.98, 0.85)
corner_radius_top_left = 14
corner_radius_top_right = 14
corner_radius_bottom_left = 14
corner_radius_bottom_right = 14

[resource]
default_font = SubResource("furniture_font")
Label/colors/font_color = Color(0.95, 0.97, 1, 1)
Button/colors/font_color = Color(1, 0.98, 0.94, 1)
Button/colors/font_hover_color = Color(1, 0.98, 0.94, 1)
Button/colors/font_pressed_color = Color(1, 0.98, 0.94, 1)
Button/colors/font_disabled_color = Color(0.80, 0.87, 0.98, 1)
Button/styles/normal = SubResource("normal")
Button/styles/hover = SubResource("hover")
Button/styles/pressed = SubResource("pressed")
Button/styles/disabled = SubResource("normal")
Button/styles/focus = SubResource("focus")
Panel/styles/panel = SubResource("card")
FurnitureIconTile/base_type = &"Panel"
FurnitureIconTile/styles/panel = SubResource("tile")
